<?xml version="1.0" ?>
<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">
    <services>
        <service id="DemoSplitShipment\Checkout\SplitShipment\SplitShipmentConfig">
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
        </service>

        <service id="DemoSplitShipment\Checkout\SplitShipment\DestinationTaxResolver">
            <argument type="tagged_iterator" tag="tax.rule_type_filter"/>
        </service>

        <!-- After products are priced (5000), before promotions and deliveries. -->
        <service id="DemoSplitShipment\Checkout\SplitShipment\SplitShipmentLineItemProcessor">
            <argument type="service" id="DemoSplitShipment\Checkout\SplitShipment\SplitShipmentConfig"/>
            <argument type="service" id="customer_address.repository"/>
            <argument type="service" id="tax.repository"/>
            <argument type="service" id="DemoSplitShipment\Checkout\SplitShipment\DestinationTaxResolver"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\QuantityPriceCalculator"/>
            <tag name="shopware.cart.collector" priority="4950"/>
            <tag name="shopware.cart.processor" priority="4950"/>
        </service>

        <!-- After Shopware builds and prices the default delivery (-5000). -->
        <service id="DemoSplitShipment\Checkout\SplitShipment\SplitShipmentDeliveryProcessor">
            <argument type="service" id="DemoSplitShipment\Checkout\SplitShipment\SplitShipmentConfig"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Delivery\DeliveryCalculator"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\QuantityPriceCalculator"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Tax\PercentageTaxRuleBuilder"/>
            <tag name="shopware.cart.processor" priority="-5100"/>
        </service>

        <service id="DemoSplitShipment\Checkout\SplitShipment\SalesChannel\SplitShipmentRoute" public="true">
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="DemoSplitShipment\Checkout\SplitShipment\SplitShipmentConfig"/>
            <argument type="service" id="customer_address.repository"/>
        </service>
    </services>
</container>
