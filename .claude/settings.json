{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(bin/lint-php.sh*)",
      "Bash(node --check *)",
      "Bash(node bin/build-admin.mjs*)"
    ],
    "ask": [
      "Bash(git push*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}
